# agent-harness configuration. Copy to %USERPROFILE%\.agent-harness\.env and adjust.
# Values may use Windows environment variables as %NAME%. Process environment variables override this file.
# Never put secrets here that you would not want in a backup; credentials stay in each agent's own home.

# Installed runtime root (code, policy, var/ state and logs).
HARNESS_HOME=%USERPROFILE%\.agent-harness

# Connected agent instances: agent:instance=home;... (agent = adapter name under adapters/).
INSTANCES="codex:personal=%USERPROFILE%\.codex;claude:default=%USERPROFILE%\.claude"

# Python 3.11+ interpreter used by the router and consumers (stdlib only).
HARNESS_PYTHON=%APPDATA%\uv\python\cpython-3.14.7-windows-x86_64-none\python.exe

# Observability hub (separate service) and the local OTLP usage receiver (both bind 127.0.0.1).
OBS_ENDPOINT=http://127.0.0.1:4319
OTLP_PORT=4320

# Notifications: at most N toasts per window (seconds).
NOTIFY_RATE_LIMIT=5/60

# Optional Herdr integration (leave empty to disable).
HERDR_BIN=

# Pinned compiler for agent hook files.
RULESYNC_VERSION=22.0.0

# Optional observability hub checkout outside HARNESS_HOME (a folder with start.ps1). Empty: <HARNESS_HOME>\hub.
HUB_DIR=

# Status orb window. 0 = headless orb: same logic (sounds, session recovery, health), no always-on-top window or tray.
ORB_UI=1
