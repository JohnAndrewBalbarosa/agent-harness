# agent-harness configuration. Copy to %USERPROFILE%\.agent-harness\.env and adjust.
# Values may use Windows environment variables as %NAME%. Process environment variables override this file.
# Never put secrets here that you would not want in a backup; credentials stay in each agent's own home.

# Installed runtime root (code, policy, var/ state and logs).
HARNESS_HOME=%USERPROFILE%\.agent-harness

# Connected agent instances: agent:instance=home;... (agent = adapter name under adapters/).
INSTANCES="codex:personal=%USERPROFILE%\.codex;claude:default=%USERPROFILE%\.claude"

# Python 3.11+ interpreter used by the router and consumers (stdlib only).
HARNESS_PYTHON=%APPDATA%\uv\python\cpython-3.14.7-windows-x86_64-none\python.exe

# Observability hub (separate service) and the local OTLP usage receiver (both bind 127.0.0.1).
OBS_ENDPOINT=http://127.0.0.1:4319
OTLP_PORT=4320

# Notifications: at most N toasts per window (seconds).
NOTIFY_RATE_LIMIT=5/60

# Optional Herdr integration (leave empty to disable).
HERDR_BIN=

# Pinned compiler for agent hook files.
RULESYNC_VERSION=22.0.0

# Status orb window. 0 = headless orb: same logic (sounds, session recovery, health), no always-on-top window or tray.
ORB_UI=1

# rtk (github.com/rtk-ai/rtk) compresses Bash output before it reaches the agent. Empty = disabled.
# Use forward slashes (hook runners: Git Bash for Claude, cmd for Codex), e.g. C:/path/to/rtk.exe
RTK_BIN=

# Context budget. Every request re-sends the whole context, so long sessions dominate token usage.
# Notify (once per 50K band per session) when a request's prompt reaches this many tokens.
CONTEXT_WARN_TOKENS=150000
# Claude auto-compaction trigger, percent (1-100) of its auto-compact window; empty = Claude's default.
# Claude ignores values above its default. Codex: set model_auto_compact_token_limit in its config.toml.
CLAUDE_AUTOCOMPACT_PCT=

# Markdown: filenames first; Rust `harness markdown read` returns explicitly selected contents.
# Activation requires a Git/registered repository below this canonical Projects directory.
AH_MARKDOWN_CONTEXT_ENABLED=1
AH_MARKDOWN_PROJECTS_DIR=%USERPROFILE%/Desktop/Projects
# Optional regex on normalized canonical repo roots. Empty = all repos below Projects; containment always applies.
AH_MARKDOWN_ALLOWED_ROOT_REGEX=
AH_MARKDOWN_INDEX_CHARS=6000
AH_MARKDOWN_SESSION_CHARS=64000
AH_MARKDOWN_TELEMETRY_ENABLED=1
# Change after verified context reset/compaction to permit rediscovery and rereads.
AH_MARKDOWN_CONTEXT_EPOCH=0
