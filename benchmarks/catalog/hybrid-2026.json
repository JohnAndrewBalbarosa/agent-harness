    { "id": "agent.escaped_regression_rate", "category": "agent-quality", "measure": "proportion", "direction": "lower", "margin": 0.02, "reference": "local-calibrated", "required": true },
    { "id": "agent.rework_rate", "category": "agent-quality", "measure": "proportion", "direction": "lower", "margin": 0.02, "reference": "local-calibrated", "required": true },
    { "id": "agent.tool_failure_rate", "category": "agent-reliability", "measure": "proportion", "direction": "lower", "margin": 0.02, "reference": "local-calibrated", "required": false },
    { "id": "agent.completion_latency_ms", "category": "agent-efficiency", "measure": "continuous", "direction": "lower", "margin": 0.10, "margin_kind": "relative", "reference": "local-calibrated", "required": false },
    { "id": "agent.tokens_per_accepted_task", "category": "agent-efficiency", "measure": "continuous", "direction": "lower", "margin": 0.10, "margin_kind": "relative", "reference": "local-calibrated", "required": false },
    { "id": "dora.change_lead_time", "category": "delivery", "measure": "continuous", "direction": "lower", "margin": 0.10, "margin_kind": "relative", "reference": "dora", "required": false },
    { "id": "dora.deployment_frequency", "category": "delivery", "measure": "continuous", "direction": "higher", "margin": 0.10, "margin_kind": "relative", "reference": "dora", "required": false },
    { "id": "dora.failed_deployment_recovery_time", "category": "delivery", "measure": "continuous", "direction": "lower", "margin": 0.10, "margin_kind": "relative", "reference": "dora", "required": false },
    { "id": "dora.change_fail_rate", "category": "delivery", "measure": "proportion", "direction": "lower", "margin": 0.02, "reference": "dora", "required": false },
    { "id": "dora.deployment_rework_rate", "category": "delivery", "measure": "proportion", "direction": "lower", "margin": 0.02, "reference": "dora", "required": false }
    ,{ "id": "eval.task_score", "category": "task-eval", "measure": "continuous", "direction": "higher", "margin": 0.05, "margin_kind": "relative", "reference": "openai-evals", "required": false }
    ,{ "id": "swebench.resolved_rate", "category": "task-eval", "measure": "proportion", "direction": "higher", "margin": 0.05, "reference": "swe-bench", "required": false }
